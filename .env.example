# Copy to .env and fill in. .env is git-ignored.

# Option 1: Bedrock API key
# AWS_BEARER_TOKEN_BEDROCK=

# Option 2: IAM credentials
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

AWS_REGION=eu-north-1
BEDROCK_MODEL_ID=eu.anthropic.claude-sonnet-5-5

# Optional: full path to tectonic.exe (defaults to tools\tectonic\tectonic.exe, then PATH)
# TECTONIC_PATH=

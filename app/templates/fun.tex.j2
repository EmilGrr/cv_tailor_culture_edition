% Section chips cycle through coral, teal and plum.
\newcounter{secn}
\newcommand{\cvsection}[1]{%
  \Needspace{3\baselineskip}\stepcounter{secn}\ifnum\value{secn}>3 \setcounter{secn}{1}\fi
  \ifcase\value{secn}\def\curcolor{coral}\or\def\curcolor{coral}\or\def\curcolor{teal}\or\def\curcolor{plum}\fi
  \vspace{0.75em}%
  \noindent\colorbox{\curcolor}{\strut\hspace{5pt}\color{white}\bfseries\small\MakeUppercase{#1}\hspace{5pt}}%
  {\color{\curcolor}\leaders\hrule height 1.2pt\hfill\kern0pt}\par\vspace{0.4em}}
\newcommand{\cventry}[3]{%
  \vspace{0.3em}\noindent{\bfseries #1}\hfill{\color{teal}\bfseries\small #2}\par
  \def\cvtmp{#3}\ifx\cvtmp\empty\else{\color{plum}\itshape #3}\par\fi}
\newcommand{\cvpara}[1]{#1\par}
\newenvironment{cvbullets}{\begin{itemize}[leftmargin=1.1em,itemsep=0.1em,topsep=0.25em,parsep=0pt,label={\color{coral}\textbullet}]}{\end{itemize}}

